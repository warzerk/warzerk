# 服务端口
PORT=3000

# sqlite：不连 SQL Server 时的本地库，适合先把页面跑起来
# mssql：公司 SQL Server 库 ai_dev。表由程序启动时自动创建
DB_DRIVER=mssql
SQLITE_PATH=data/vendors.db

# --- SQL Server，仅 DB_DRIVER=mssql 时使用 ---
# 公网：202.101.1.182:15333    公司内网：126.202.202.246:1433
MSSQL_SERVER=202.101.1.182
MSSQL_PORT=15333
MSSQL_DATABASE=ai_dev
MSSQL_USER=
MSSQL_PASSWORD=
# 内网自签或未配证书时保持 true；已正确配置证书后再改为 false
MSSQL_ENCRYPT=true
MSSQL_TRUST_CERT=true

# --- 用友 YonSuite 自建应用。也可在网页「连接设置」里填写，写过之后以数据库中的值为准 ---
YONSUITE_HOST=https://c3.yonyoucloud.com
YONSUITE_APP_KEY=
YONSUITE_APP_SECRET=
# 自建应用的 AppKey 已经绑定租户。这里只作记录，令牌请求不会单独上传。
YONSUITE_TENANT_ID=
YONSUITE_PAGE_SIZE=500
# 全量/增量同步时，是否再按供应商 ID 调详情接口，补齐银行、联系人等子表
YONSUITE_ENRICH_DETAIL=true
# 个别租户不传组织会报错或查空。格式与开放平台示例一致，例如 [666666]，留空表示不筛选
YONSUITE_ORG=
YONSUITE_VENDOR_ORG=

# 详情接口。列表接口字段已经很多；详情失败时仍会保存列表结果
YONSUITE_DETAIL_PATH=/yonbip/digitalModel/vendor/detail
YONSUITE_DETAIL_METHOD=GET
YONSUITE_DETAIL_CONCURRENCY=4

# 每天在服务器本地时间的该小时跑一次增量同步。留空则只手动同步
# 建议进程时区设为中国：TZ=Asia/Shanghai
SYNC_DAILY_HOUR=

# 设为 1 时在日志打印接口路径（不打印密钥和令牌）
YONSUITE_DEBUG=0
