# Server
PORT=3000

# Postgres
DATABASE_URL="postgresql://user:password@localhost:5432/yonsuite_query?schema=public"

# Redis (used by BullMQ for the hourly sync queue)
REDIS_URL="redis://localhost:6379"

# Auth
JWT_SECRET="change-me"
JWT_EXPIRES_IN="12h"

# YonSuite OpenAPI
YONSUITE_APP_KEY=""
YONSUITE_APP_SECRET=""
YONSUITE_TENANT_ID=""
YONSUITE_GATEWAY_BASE_URL="https://c3.yonyoucloud.com/iuap-api-gateway"
YONSUITE_AUTH_URL="https://c3.yonyoucloud.com/iuap-api-auth/open-auth/selfAppAuth/getAccessToken"

# Sync
SYNC_CRON="0 0 * * * *"
